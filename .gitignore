# ---------------------------------------------------------------------------
# Unreal Engine: generated and machine-specific files
# ---------------------------------------------------------------------------

# Compiled binaries (regenerated by building the project)
Binaries/
Plugins/**/Binaries/

# Build intermediates, editor caches, logs, crash dumps, autosaves
Intermediate/
Plugins/**/Intermediate/
DerivedDataCache/
Saved/

# Packaged builds
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Built lighting data for maps (rebuilt by the editor, and huge)
*_BuiltData.uasset

# Editor write-permission probes
WritePermissions.*.temp

# ---------------------------------------------------------------------------
# IDE and OS files
# ---------------------------------------------------------------------------

.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.code-workspace
*.xcodeproj
*.xcworkspace
.DS_Store
Thumbs.db
desktop.ini

# Compiled objects, libraries and executables
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa
*.pdb

# Version-control leftovers from Diversion
.dvignore
.diversion/

# ---------------------------------------------------------------------------
# Source art: raw imports kept next to their .uasset (the .uasset is what the
# project uses)
# ---------------------------------------------------------------------------

Content/**/*.fbx
Content/**/*.fbm/
Content/**/*_fbm/

